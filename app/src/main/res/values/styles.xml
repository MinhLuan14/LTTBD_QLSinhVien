<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Primary Pill Button -->
    <style name="Widget.EduSync.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Custom CardView for Items -->
    <style name="Widget.EduSync.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border_card</item>
    </style>

    <!-- Custom Outlined Input Layout -->
    <style name="Widget.EduSync.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1.2dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>
