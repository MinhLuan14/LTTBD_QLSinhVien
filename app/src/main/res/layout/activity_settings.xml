<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header App Bar -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:paddingTop="36dp"
            android:paddingBottom="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingEnd="@dimen/spacing_normal">

                <!-- Back Navigation Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/btn_back"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <!-- Screen Title -->
                <TextView
                    android:id="@+id/tvScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/title_settings"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <!-- Scrollable Settings Content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsContainer"
                style="@style/Widget.EduSync.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="@dimen/radius_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top Settings Header Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:layout_width="@dimen/form_header_icon_size"
                            android:layout_height="@dimen/form_header_icon_size"
                            android:background="@drawable/bg_icon_badge_large">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_settings"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/title_settings"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SECTION 1: Cài đặt giao diện -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sun_theme"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/section_appearance_settings"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 1.1: Chế độ tối (Dark Mode) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowDarkMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconDarkMode"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_warning"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_sun_theme"
                                app:tint="@color/warning" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvDarkModeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_dark_mode"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/switchDarkMode"
                            app:layout_constraintStart_toEndOf="@id/flIconDarkMode"
                            app:layout_constraintTop_toTopOf="@id/flIconDarkMode" />

                        <TextView
                            android:id="@+id/tvDarkModeSub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_dark_mode_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/switchDarkMode"
                            app:layout_constraintStart_toEndOf="@id/flIconDarkMode"
                            app:layout_constraintTop_toBottomOf="@id/tvDarkModeTitle" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/primary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Row 1.2: Tự động theo hệ thống -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowSystemTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconSystemTheme"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_palette"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvSystemThemeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_system_theme"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/switchSystemTheme"
                            app:layout_constraintStart_toEndOf="@id/flIconSystemTheme"
                            app:layout_constraintTop_toTopOf="@id/flIconSystemTheme" />

                        <TextView
                            android:id="@+id/tvSystemThemeSub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_system_theme_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/switchSystemTheme"
                            app:layout_constraintStart_toEndOf="@id/flIconSystemTheme"
                            app:layout_constraintTop_toBottomOf="@id/tvSystemThemeTitle" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchSystemTheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/primary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Row 1.3: Kích thước chữ -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowFontSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconFontSize"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_notes"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvFontSizeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_font_size"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowFontSize"
                            app:layout_constraintStart_toEndOf="@id/flIconFontSize"
                            app:layout_constraintTop_toTopOf="@id/flIconFontSize" />

                        <TextView
                            android:id="@+id/tvFontSizeValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_font_size_sub"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowFontSize"
                            app:layout_constraintStart_toEndOf="@id/flIconFontSize"
                            app:layout_constraintTop_toBottomOf="@id/tvFontSizeTitle" />

                        <ImageView
                            android:id="@+id/ivArrowFontSize"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/icon_tint_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Row 1.4: Ngôn ngữ hiển thị -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconLanguage"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_language"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvLanguageTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_language"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowLanguage"
                            app:layout_constraintStart_toEndOf="@id/flIconLanguage"
                            app:layout_constraintTop_toTopOf="@id/flIconLanguage" />

                        <TextView
                            android:id="@+id/tvLanguageValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_language_sub"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowLanguage"
                            app:layout_constraintStart_toEndOf="@id/flIconLanguage"
                            app:layout_constraintTop_toBottomOf="@id/tvLanguageTitle" />

                        <ImageView
                            android:id="@+id/ivArrowLanguage"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/icon_tint_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- SECTION 2: Thông báo & Học tập -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_notification"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/section_app_settings"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 2.1: Thông báo nhắc nhở -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconNotifications"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_notification"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvNotificationsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_notifications"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/switchNotifications"
                            app:layout_constraintStart_toEndOf="@id/flIconNotifications"
                            app:layout_constraintTop_toTopOf="@id/flIconNotifications" />

                        <TextView
                            android:id="@+id/tvNotificationsSub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_notifications_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/switchNotifications"
                            app:layout_constraintStart_toEndOf="@id/flIconNotifications"
                            app:layout_constraintTop_toBottomOf="@id/tvNotificationsTitle" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/primary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Row 2.2: Thang điểm hiển thị -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowGradeScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconGradeScale"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_credit"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvGradeScaleTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_grade_scale"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowGradeScale"
                            app:layout_constraintStart_toEndOf="@id/flIconGradeScale"
                            app:layout_constraintTop_toTopOf="@id/flIconGradeScale" />

                        <TextView
                            android:id="@+id/tvGradeScaleValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_grade_scale_sub"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowGradeScale"
                            app:layout_constraintStart_toEndOf="@id/flIconGradeScale"
                            app:layout_constraintTop_toBottomOf="@id/tvGradeScaleTitle" />

                        <ImageView
                            android:id="@+id/ivArrowGradeScale"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/icon_tint_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Row 2.3: Tự động sao lưu dữ liệu -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowAutoBackup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconAutoBackup"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_database"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvAutoBackupTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_auto_backup"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/switchAutoBackup"
                            app:layout_constraintStart_toEndOf="@id/flIconAutoBackup"
                            app:layout_constraintTop_toTopOf="@id/flIconAutoBackup" />

                        <TextView
                            android:id="@+id/tvAutoBackupSub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_auto_backup_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/switchAutoBackup"
                            app:layout_constraintStart_toEndOf="@id/flIconAutoBackup"
                            app:layout_constraintTop_toBottomOf="@id/tvAutoBackupTitle" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:thumbTint="@color/white"
                            app:trackTint="@color/primary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- SECTION 3: Bảo mật & Dữ liệu -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock_setting"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/section_security_data"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Row 3.1: Đổi mật khẩu -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconChangePassword"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock_setting"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvChangePasswordTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_change_password"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowChangePassword"
                            app:layout_constraintStart_toEndOf="@id/flIconChangePassword"
                            app:layout_constraintTop_toTopOf="@id/flIconChangePassword" />

                        <TextView
                            android:id="@+id/tvChangePasswordSub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_change_password_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowChangePassword"
                            app:layout_constraintStart_toEndOf="@id/flIconChangePassword"
                            app:layout_constraintTop_toBottomOf="@id/tvChangePasswordTitle" />

                        <ImageView
                            android:id="@+id/ivArrowChangePassword"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/icon_tint_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Row 3.2: Khôi phục cài đặt mặc định -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/rowResetSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_menu_item_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/flIconResetSettings"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge_error"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_refresh"
                                app:tint="@color/error" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvResetSettingsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_reset_default"
                            android:textColor="@color/error"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowResetSettings"
                            app:layout_constraintStart_toEndOf="@id/flIconResetSettings"
                            app:layout_constraintTop_toTopOf="@id/flIconResetSettings" />

                        <TextView
                            android:id="@+id/tvResetSettingsSub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/setting_reset_default_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@id/ivArrowResetSettings"
                            app:layout_constraintStart_toEndOf="@id/flIconResetSettings"
                            app:layout_constraintTop_toBottomOf="@id/tvResetSettingsTitle" />

                        <ImageView
                            android:id="@+id/ivArrowResetSettings"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/icon_tint_secondary" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Save Settings Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveSettings"
                        style="@style/Widget.EduSync.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_primary"
                        android:layout_marginTop="24dp"
                        android:text="@string/btn_save_settings"
                        app:cornerRadius="@dimen/radius_button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
