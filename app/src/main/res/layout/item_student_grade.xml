<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="17dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- COURSE ICON -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="@color/primary_light"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgGradeCourseIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_book"
                app:tint="@color/primary"
                android:contentDescription="Môn học"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- COURSE INFORMATION -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <!-- COURSE NAME -->
            <TextView
                android:id="@+id/tvGradeCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lập trình Java"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- PROCESS SCORE -->
            <TextView
                android:id="@+id/tvProcessScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Điểm quá trình: 8.5"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

            <!-- EXAM SCORE -->
            <TextView
                android:id="@+id/tvExamScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Điểm thi: 8.0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="1dp"
            android:layout_height="43dp"
            android:layout_marginHorizontal="9dp"
            android:background="@color/border_color"/>

        <!-- FINAL SCORE -->
        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điểm tổng kết"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                android:gravity="center"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFinalScore"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="@color/success_light"
                app:cardCornerRadius="9dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvFinalScore"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="8.2"
                    android:textColor="@color/success"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
