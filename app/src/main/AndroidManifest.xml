<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduSync">

        <!-- Màn hình khởi chạy Splash -->
        <activity
            android:name=".ui.admin.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Đăng nhập -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- Đổi mật khẩu -->
        <activity
            android:name=".ui.auth.ChangePasswordActivity"
            android:exported="true" />

        <!-- Trang chủ Admin -->
        <activity
            android:name=".ui.admin.main.MainActivity"
            android:exported="true" />

        <!-- Trang chủ Sinh viên -->
        <activity
            android:name=".ui.student.StudentMainActivity"
            android:exported="true" />

        <!-- Trang cá nhân dùng chung -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="true" />

        <!-- Quản lý tài khoản (Nguyên) -->
        <activity
            android:name=".ui.admin.account.AccountListActivity"
            android:exported="true" />

        <!-- Quản lý sinh viên (Hoàng) -->
        <activity
            android:name=".ui.admin.student.StudentListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.admin.student.StudentFormActivity"
            android:exported="true" />

        <!-- Quản lý lớp học -->
        <activity
            android:name=".ui.admin.classroom.ClassListActivity"
            android:exported="true" />

        <!-- Quản lý môn học -->
        <activity
            android:name=".ui.admin.subject.SubjectListActivity"
            android:exported="true" />

        <!-- Quản lý học phần -->
        <activity
            android:name=".ui.admin.course.CourseListActivity"
            android:exported="true" />

        <!-- Quản lý khoa -->
        <activity
            android:name=".ui.admin.department.DepartmentListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.admin.department.DepartmentFormActivity"
            android:exported="true" />

        <!-- Quản lý chuyên ngành -->
        <activity
            android:name=".ui.admin.major.MajorListActivity"
            android:exported="true" />

        <activity
            android:name=".ui.admin.major.MajorFormActivity"
            android:exported="true" />

        <!-- Quản lý điểm -->
        <activity
            android:name=".ui.admin.grade.GradeEntryActivity"
            android:exported="true" />

        <activity
            android:name=".ui.admin.grade.GradeLookupActivity"
            android:exported="true" />

    </application>

</manifest>
