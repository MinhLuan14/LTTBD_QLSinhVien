<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduSync">

        <!-- Màn hình khởi chạy -->
        <activity
            android:name=".ui.admin.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Đăng nhập -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- Trang chủ -->
        <activity
            android:name=".ui.admin.main.MainActivity"
            android:exported="false" />

        <!-- Các màn hình khác -->
        <activity
            android:name=".ui.admin.grade.GradeEntryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.grade.GradeLookupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.student.StudentListActivity"
            android:exported="false" />
        <!-- Quản lý khoa -->
        <activity
            android:name=".ui.admin.department.DepartmentListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.department.DepartmentFormActivity"
            android:exported="false" />
        <!-- Quản lý chuyên ngành -->
        <activity
            android:name=".ui.admin.major.MajorListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.major.MajorFormActivity"
            android:exported="false" />
    </application>

</manifest>
